# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (PostgreSQL Backend & Auth)
# Configura estas variables en tu proyecto de Vercel y Supabase para producción
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# MULTI-TENANT & CUSTOM DOMAINS (Vercel)
# Dominio wildcard principal para subdominios automáticos (ej. *.setmio.com)
VITE_SETMIO_ROOT_DOMAIN="setmio.com"

